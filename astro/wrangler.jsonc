{
  // Cloudflare Workers Builds deploys the static Astro build as the soiguru-minimal Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soiguru-minimal",
  // The Worker only handles /api/places/* (Google photos via the owner app, same-origin); everything else is the static build.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/places/*", "/media/*"]
  }
}
