---
/**
 * BottomNav — the phone tab bar: Home, Search, Saved, Owner and Menu. Saved lists the places
 * saved on this device; Owner goes to the owner app. Menu opens a bottom sheet (`Sheet`) with
 * the header's links (categories, map), the cities, the language and the owner links, so
 * phones need no menu button in the header. Hidden from 960px, where the header has it all.
 */
import Icon from './Icon.astro';
import Sheet from './Sheet.astro';
import LanguageToggle from './LanguageToggle.astro';
import { getSoiGuru, claimUrl, headerLinks, type City } from '../../lib/soiguru/data';

interface Props {
    city: City;
    active?: 'home' | 'search' | 'saved';
    /** Owner app URL; the Owner tab is omitted without one */
    ownerHref?: string;
}

const { city, active, ownerHref } = Astro.props;
const data = await getSoiGuru();
const links = headerLinks(data, city);
const listHref = claimUrl(data.config, city) ?? ownerHref;
const tabs = ownerHref ? 5 : 4;
---

<nav class="tkg-nav sg-nav" aria-label="Main" style={`grid-template-columns: repeat(${tabs}, 1fr)`}>
    <a href={`/${city.id}`} class:list={{ 'tkg-on': active === 'home' }} aria-current={active === 'home' ? 'page' : undefined}>
        <Icon name="home" /><span data-th="หน้าแรก">Home</span>
    </a>
    <a href={`/${city.id}/search`} class:list={{ 'tkg-on': active === 'search' }} aria-current={active === 'search' ? 'page' : undefined}>
        <Icon name="search" /><span data-th="ค้นหา">Search</span>
    </a>
    <a href={`/${city.id}/saved`} class:list={{ 'tkg-on': active === 'saved' }} aria-current={active === 'saved' ? 'page' : undefined}>
        <Icon name="heart" /><span data-th="บันทึกไว้">Saved</span>
    </a>
    {
        ownerHref && (
            <a href={ownerHref} data-umami-event="owner-tab">
                <Icon name="user" /><span data-th="เจ้าของร้าน">Owner</span>
            </a>
        )
    }
    <button type="button" class="sg-nav-menu" data-sheet-open="menu" aria-haspopup="dialog">
        <Icon name="menu" /><span data-th="เมนู">Menu</span>
    </button>
</nav>

<Sheet id="menu" title="Menu" titleTh="เมนู">
    <nav class="sg-msheet-links" aria-label={`${city.name} menu`}>
        {
            links.map((l) => (
                <a href={l.href}>
                    <Icon name={l.href.endsWith('view=map') ? 'map' : 'chevron-right'} />
                    <span data-th={l.label_th}>{l.label}</span>
                </a>
            ))
        }
    </nav>
    <div class="sg-msheet-block">
        <p class="sg-pop-title" data-th="เมือง">Cities</p>
        <div class="sg-chip-wrap">
            {
                data.cities.map((c) => (
                    <a class:list={['tkg-chip', { 'tkg-chip-on': c.id === city.id }]} href={`/${c.id}`} data-th={c.name_th}>
                        {c.name}
                    </a>
                ))
            }
        </div>
    </div>
    <div class="sg-msheet-block">
        <p class="sg-pop-title" data-th="ภาษา">Language</p>
        <LanguageToggle />
    </div>
    <div class="sg-msheet-block sg-msheet-owner">
        {
            ownerHref && (
                <a class="sg-btn sg-btn-secondary sg-btn-lg sg-btn-block" href={ownerHref} data-umami-event="owner-login">
                    <Icon name="user" />
                    <span data-th="เข้าสู่ระบบเจ้าของร้าน">Owner login</span>
                </a>
            )
        }
        {
            listHref && (
                <a class="sg-btn sg-btn-accent sg-btn-lg sg-btn-block" href={listHref} data-umami-event="list-business" data-th="ลงทะเบียนธุรกิจ">
                    List your business
                </a>
            )
        }
    </div>
</Sheet>
