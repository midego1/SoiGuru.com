---
/**
 * KarstScene — the hero picture: limestone karsts, the sun and a longtail boat on the Andaman
 * Sea, drawn in the theme's colours (the design system has no stock photos). Decorative.
 */
---

<svg class="sg-scene" viewBox="0 0 440 302" role="presentation" aria-hidden="true" focusable="false">
    <rect width="440" height="302" fill="var(--sea-tint)"></rect>
    <circle cx="318" cy="84" r="34" fill="var(--sun)"></circle>
    <path d="M0 214 C24 120 52 96 70 118 C84 70 112 58 128 96 C140 128 150 170 160 214 Z" fill="var(--area-1)" opacity="0.55"></path>
    <path d="M150 214 C168 150 178 104 206 86 C226 74 242 98 248 132 C258 110 276 112 286 146 C296 176 300 196 306 214 Z" fill="var(--area-1)"></path>
    <path d="M286 214 C302 176 318 160 336 168 C350 140 372 134 388 162 C404 190 418 204 440 214 Z" fill="var(--area-5)" opacity="0.8"></path>
    <rect y="210" width="440" height="92" fill="var(--sea)"></rect>
    <path d="M24 240 h60 M120 262 h84 M250 244 h70 M340 272 h70 M60 286 h48" stroke="var(--on-sea)" stroke-width="3" stroke-linecap="round" opacity="0.35"></path>
    <g transform="translate(150 230)">
        <path d="M0 18 C30 30 92 30 128 14 L132 4 C96 14 40 16 6 8 Z" fill="var(--hero-bg)"></path>
        <path d="M128 14 L150 -6" stroke="var(--hero-bg)" stroke-width="3" stroke-linecap="round"></path>
        <path d="M40 10 V-8 h36 V10" fill="none" stroke="var(--hero-bg)" stroke-width="3" stroke-linejoin="round"></path>
        <path d="M36 -8 h44" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"></path>
    </g>
</svg>
