---
/**
 * ListingPhoto — the listing's first photo, or (no photo) the drawn category scene
 * (`CategoryArt`, cropped to the square). Never a stock image. The default slot is laid over
 * the photo (the "Featured" chip on list cards).
 */
import CategoryArt from './CategoryArt.astro';
import type { Listing } from '../../lib/soiguru/data';

interface Props {
    listing: Listing;
    /** Index into `listing.images` */
    index?: number;
    /** Rendered size in px, for the image's width/height hints */
    size?: number;
    /** `eager` for the photo strip above the fold */
    loading?: 'lazy' | 'eager';
}

const { listing, index = 0, size = 96, loading = 'lazy' } = Astro.props;
const src = listing.images[index];
---

{
    src ? (
        <div class="tkg-photo">
            <img class="sg-photo-img" src={src} alt="" width={size} height={size} loading={loading} decoding="async" />
            <slot />
        </div>
    ) : (
        <div class="tkg-photo sg-photo-empty" aria-hidden="true">
            <CategoryArt category={listing.category} />
            <slot />
        </div>
    )
}
