---
/**
 * HoursTable — the "Opening hours" card of the listing page (website mockup): the week as a
 * two-column table, one row per day (2026-10-18; days were merged before), 24-hour clock, tabular
 * numerals. The browser marks today's row (`body-strong`, day in `sea`, "· today") and moves
 * it first; today is not known at build time. Without hours the card says so. The default
 * slot goes under the table (the "Updated by the owner …" line).
 */
import { hoursRows } from '../../lib/soiguru/hours';
import type { Listing } from '../../lib/soiguru/data';

interface Props {
    listing: Listing;
}

const { listing } = Astro.props;
// Every day on its own row (the listing page shows the whole week, today first).
const rows = listing.hours ? hoursRows(listing.hours, { merge: false, longNames: true }) : [];
---

<section class="sg-card sg-hours-sec" aria-labelledby="sg-hours-h">
    <h2 class="sg-card-h" id="sg-hours-h">
        <span data-th="เวลาเปิด-ปิด">Opening hours</span>
    </h2>
    {listing.hours_note && <p class="sg-card-note">{listing.hours_note}</p>}
    {
        rows.length > 0 ? (
            <table class="tkg-hours" data-hours-table data-hours={listing.hoursJson}>
                <tbody>
                    {rows.map((row, i) => (
                        <tr data-days={row.days.join(' ')} data-order={i}>
                            <td>
                                <span data-th={row.labelTh}>{row.label}</span>
                                <span class="sg-today-label" hidden>
                                    {' '}<span data-th="· วันนี้">· today</span>
                                </span>
                                <small class="sg-today-next" data-today-next hidden></small>
                            </td>
                            {row.closed ? (
                                <td class="tkg-closed-day" data-th="ปิด">
                                    Closed
                                </td>
                            ) : row.allDay ? (
                                <td data-th="24 ชั่วโมง">Open 24 hours</td>
                            ) : (
                                <td>
                                    {row.times.map((t, i) => (
                                        <>
                                            {i > 0 && <br />}
                                            {t}
                                        </>
                                    ))}
                                </td>
                            )}
                        </tr>
                    ))}
                </tbody>
            </table>
        ) : (
            <p class="sg-card-text" data-th="ยังไม่ได้ยืนยันเวลาเปิด-ปิด โทรหรือส่งข้อความถามก่อนไป">
                Opening hours aren't confirmed yet. Call or message before you go.
            </p>
        )
    }
    <slot />
</section>
