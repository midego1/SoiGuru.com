---
/**
 * CategoryArt — the drawn picture for a place without photos: a small scene in the theme's
 * colours with the category icon on a badge in front. Two scenes: `sea` (karsts, the Andaman
 * and a longtail boat, for tours, diving and stays) and `street` (a shopfront with a striped
 * awning and string lights, for everything else). The awning and badge colour comes from the
 * category, so neighbouring cards differ. On the wide listing-page band (`lg`) the scene keeps
 * its shape in the middle and the sky and ground run on to both sides. Decorative: the name next to it says what it is.
 * Never a stock image.
 */
import Icon from './Icon.astro';
import type { Category } from '../../lib/soiguru/data';

interface Props {
    category?: Category;
    /** `sm` for cards (smaller badge), `lg` for the listing page */
    size?: 'sm' | 'lg';
    class?: string;
}

const SEA = new Set(['tours', 'dive-shops', 'hotels']);
const { category, size = 'sm', class: className } = Astro.props;
const id = category?.id ?? 'other';
const scene = SEA.has(id) ? 'sea' : 'street';
// A stable colour per category, from the five area colours.
const hash = [...id].reduce((n, c) => (n * 31 + c.charCodeAt(0)) >>> 0, 7);
const tone = `var(--area-${(hash % 5) + 1})`;
const stripes = Array.from({ length: 10 }, (_, i) => i);
---

<div class:list={['sg-art', `sg-art-${size}`, `sg-art-${scene}`, className]} style={`--art: ${tone}`} aria-hidden="true">
    <svg viewBox="0 0 400 240" preserveAspectRatio={size === 'lg' ? 'xMidYMax meet' : 'xMidYMid slice'} focusable="false">
        <rect width="400" height="240" fill="var(--sea-tint)"></rect>
        <circle cx="332" cy="58" r="26" fill="var(--sun)"></circle>
        {
            scene === 'sea' ? (
                <>
                    <path d="M0 168 C22 96 48 76 64 94 C78 56 104 46 118 76 C130 104 138 138 148 168 Z" fill="var(--area-1)" opacity="0.5" />
                    <path d="M120 168 C138 116 150 80 176 66 C194 56 210 76 216 104 C226 86 242 88 252 116 C262 142 268 156 272 168 Z" fill="var(--art)" />
                    <path d="M256 168 C270 138 286 124 302 130 C316 108 336 104 350 126 C366 150 380 160 400 168 Z" fill="var(--area-5)" opacity="0.75" />
                    <rect y="164" width="400" height="76" fill="var(--sea)" />
                    <path d="M24 190 h56 M118 212 h70 M240 196 h64 M326 220 h56 M60 230 h40" stroke="var(--on-sea)" stroke-width="3" stroke-linecap="round" opacity="0.35" />
                    <g transform="translate(232 186)">
                        <path d="M0 14 C24 24 74 24 102 11 L106 3 C78 11 32 13 5 6 Z" fill="var(--hero-bg)" />
                        <path d="M102 11 L120 -5" stroke="var(--hero-bg)" stroke-width="3" stroke-linecap="round" />
                        <path d="M32 8 V-6 h28 V8" fill="none" stroke="var(--hero-bg)" stroke-width="3" stroke-linejoin="round" />
                        <path d="M28 -6 h36" stroke="var(--accent)" stroke-width="4" stroke-linecap="round" />
                    </g>
                </>
            ) : (
                <>
                    <path d="M0 120 C18 70 40 56 54 72 C66 44 88 38 100 62 C110 84 116 104 122 120 Z" fill="var(--area-1)" opacity="0.35" />
                    <path d="M290 120 C304 92 318 80 332 88 C344 68 362 64 374 84 C386 104 394 114 400 120 Z" fill="var(--area-5)" opacity="0.35" />
                    <rect y="200" width="400" height="40" fill="var(--surface-200)" />
                    <rect x="70" y="64" width="260" height="140" rx="4" fill="var(--surface)" />
                    <rect x="70" y="64" width="260" height="18" fill="var(--art)" />
                    {stripes.map((i) => (
                        <path
                            d={`M${70 + i * 26} 82 h26 v18 a13 13 0 0 1 -26 0 Z`}
                            fill={i % 2 === 0 ? 'var(--art)' : 'var(--surface)'}
                            stroke="var(--art)"
                            stroke-width="1.5"
                        />
                    ))}
                    <rect x="92" y="128" width="58" height="76" rx="3" fill="var(--sea-tint)" stroke="var(--line)" stroke-width="2" />
                    <rect x="250" y="128" width="58" height="50" rx="3" fill="var(--sea-tint)" stroke="var(--line)" stroke-width="2" />
                    <path d="M150 204 h100" stroke="var(--line)" stroke-width="2" />
                    <path d="M0 40 Q 35 58 70 46 M330 46 Q 365 58 400 40" fill="none" stroke="var(--ink-muted)" stroke-width="1.5" opacity="0.6" />
                    {[14, 34, 54, 346, 366, 386].map((x) => (
                        <circle cx={x} cy={x < 200 ? 46 + Math.sin(x / 20) * 4 : 47 + Math.sin(x / 20) * 4} r="3.5" fill="var(--sun)" />
                    ))}
                    <rect x="38" y="176" width="22" height="28" rx="11" fill="var(--area-4)" opacity="0.8" />
                    <rect x="346" y="168" width="26" height="36" rx="13" fill="var(--area-4)" opacity="0.8" />
                </>
            )
        }
    </svg>
    <span class="sg-art-badge">
        <Icon name={category?.icon ?? 'image'} class={size === 'lg' ? 'tkg-i-24' : undefined} />
    </span>
</div>
