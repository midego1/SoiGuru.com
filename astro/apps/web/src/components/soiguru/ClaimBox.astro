---
/**
 * ClaimBox — the "Is this your business?" card of the listing page (website mockup): one
 * sentence, the price and the claim button. Followed by the blame-free "hours may be out of
 * date" note. Renders nothing on claimed listings.
 */
import Icon from './Icon.astro';
import type { Listing } from '../../lib/soiguru/data';

interface Props {
    listing: Listing;
    href?: string;
}

const { listing, href } = Astro.props;
---

{
    !listing.claimed && (
        <div class="sg-claim-sec">
            {href && (
                <section class="sg-card sg-card-tint" aria-labelledby="sg-claim-h">
                    <h2 class="sg-card-h" id="sg-claim-h" data-th="นี่คือธุรกิจของคุณใช่ไหม?">
                        Is this your business?
                    </h2>
                    <p class="sg-card-text" data-th="เคลมเพื่อแก้ไขเวลาเปิด-ปิด รูปภาพ และช่องทางติดต่อ พร้อมรับป้ายยืนยันเจ้าของร้าน ฿100 / เดือน หรือ ฿1,000 / ปี">
                        Claim it to update hours, photos and contact details, and get a Verified owner badge. ฿100 / month or ฿1,000 / year.
                    </p>
                    <a class="sg-btn sg-btn-ink sg-btn-lg sg-btn-block" href={href} data-umami-event="claim-listing">
                        <Icon name="shield" />
                        <span data-th="เคลมร้านนี้">Claim this listing</span>
                    </a>
                    <p class="sg-card-text sg-claim-how">
                        <a href="/for-owners" data-th="วิธีเคลมและสิ่งที่คุณจะได้รับ">How claiming works and what you get</a>
                    </p>
                </section>
            )}
            <p class="sg-note">
                <Icon name="info" class="tkg-i-16" />
                <span data-th="เวลาอาจไม่เป็นปัจจุบัน: เจ้าของยังไม่ได้จัดการรายการนี้">Hours may be out of date: this listing isn't managed by its owner yet.</span>
            </p>
        </div>
    )
}
