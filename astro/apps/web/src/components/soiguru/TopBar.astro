---
/**
 * TopBar — the bar on every screen.
 *
 * Brand mode (no `back`): the website header (`SiteHeader`, from the mockup) at every width.
 *
 * Back mode: the 56px app bar on phones — back button, a two-line title and actions passed
 * in the default slot. From 960px the website header sits above it and the bar becomes the
 * page's title row (back link, title, actions), no longer sticky.
 *
 * `nav` is kept for callers: its city feeds the header (whose links replaced TopNav).
 */
import Icon from './Icon.astro';
import SiteHeader from './SiteHeader.astro';
import type { City } from '../../lib/soiguru/data';

interface Props {
    /** City of the page (header city picker and links) */
    city?: City;
    /** Back link (back mode) */
    back?: { href: string; label: string };
    /** Title in back mode */
    title?: string;
    /** Thai title, swapped in when the UI language is Thai */
    titleTh?: string;
    /** Second line under the title */
    subtitle?: string;
    subtitleTh?: string;
    /** City navigation (the city is used by the header; `active` is no longer shown) */
    nav?: { city: City; active?: 'home' | 'search' | 'saved'; ownerHref?: string };
    /** Desktop header with the search field in place of the links (results pages) */
    search?: boolean;
}

const { city, back, title, titleTh, subtitle, subtitleTh, nav, search = false } = Astro.props;
const pageCity = city ?? nav?.city;
---

{
    back ? (
        <>
            <SiteHeader city={pageCity} class="sg-sh-desk" search={search} />
            <header class="tkg-topbar sg-backbar">
                <a class="tkg-iconbtn" href={back.href} aria-label={back.label}>
                    <Icon name="chevron-left" />
                </a>
                <div class="sg-topbar-title">
                    <span data-th={titleTh}>{title}</span>
                    {subtitle && <small data-th={subtitleTh}>{subtitle}</small>}
                </div>
                <slot />
            </header>
        </>
    ) : (
        <SiteHeader city={pageCity} />
    )
}
