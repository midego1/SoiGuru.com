---
/**
 * ListingPage (`/<city>/<area>/<slug>`, e.g. `/krabi/ao-nang/krabi-nail`) — one business,
 * in the order of a visitor's questions: what is it, can I go now, how do I reach it, when
 * is it open, what should I know, where exactly, is this trustworthy, what else is near.
 *
 * Website layout (mockup): breadcrumb, photo grid, then the business (chips, name, status,
 * action buttons, About, Good to know, Location, Nearby) beside a sticky column with the
 * opening hours, the claim card and the report link. Phones stack it as head → hours → body.
 *
 * Server-rendered with `LocalBusiness` JSON-LD (with `openingHoursSpecification`) so it
 * ranks for searches like "nail salon ao nang".
 */
import SoiGuruLayout from '../../../layouts/SoiGuruLayout.astro';
import SiteHeader from '../../../components/soiguru/SiteHeader.astro';
import Icon from '../../../components/soiguru/Icon.astro';
import OpenStatus from '../../../components/soiguru/OpenStatus.astro';
import ContactBar from '../../../components/soiguru/ContactBar.astro';
import HoursTable from '../../../components/soiguru/HoursTable.astro';
import StaticMap from '../../../components/soiguru/StaticMap.astro';
import ClaimBox from '../../../components/soiguru/ClaimBox.astro';
import ListingCard from '../../../components/soiguru/ListingCard.astro';
import SaveButton from '../../../components/soiguru/SaveButton.astro';
import CategoryArt from '../../../components/soiguru/CategoryArt.astro';
import { getSoiGuru, claimUrl, ownerUrl, reportUrl, type Listing } from '../../../lib/soiguru/data';
import { breadcrumbJsonLd, localBusinessJsonLd } from '../../../lib/soiguru/jsonld';
import { priceBand, formatDate } from '../../../lib/soiguru/format';
import { appleMapsUrl, directionsUrl, distanceMetres, mapsEmbedUrl, mapsSearchUrl } from '../../../lib/soiguru/geo';

export async function getStaticPaths() {
    const { listings } = await getSoiGuru();
    return listings
        .filter((l) => l.area)
        .map((listing) => ({ params: { city: listing.city.id, area: listing.area!.id, slug: listing.slug }, props: { listing } }));
}

interface Props {
    listing: Listing;
}

const { listing } = Astro.props;
const data = await getSoiGuru();
const { config } = data;
const { city, area, category } = listing;
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const price = priceBand(listing.price_band);

// Nearby: the closest other listings within 1.5 km; the browser shows the first two open.
const nearby = listing.geo
    ? data.listings
            .filter((l) => l.slug !== listing.slug && l.city.id === city.id && l.geo)
            .map((l) => ({ l, d: distanceMetres(listing.geo!, l.geo!) }))
            .filter((x) => x.d <= 1500)
            .sort((a, b) => a.d - b.d)
            .slice(0, 8)
    : [];

const provenance =
    listing.updated_by === 'owner' ? 'Updated by the owner' : listing.updated_by === 'editor' ? 'Updated by SoiGuru' : 'Added from public sources';
const report = reportUrl(config, listing);
// More of the same category: in the same area when there are at least 3 there, else in the city; best rated first; not the nearby ones.
const nearbySlugs = new Set(nearby.map((x) => x.l.slug));
const sameCategory = data.listings
    .filter((l) => l.slug !== listing.slug && l.city.id === city.id && !!category && l.category?.id === category.id && !nearbySlugs.has(l.slug))
    .sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0));
const sameArea = sameCategory.filter((l) => area && l.area?.id === area.id);
const similarIn = sameArea.length >= 3 ? (area?.name ?? city.name) : city.name;
const similarInTh = sameArea.length >= 3 ? (area?.name_th ?? area?.name ?? city.name_th ?? city.name) : (city.name_th ?? city.name);
const similar = (sameArea.length >= 3 ? sameArea : sameCategory).slice(0, 6);
const shown = listing.images.slice(0, 5);
// No photos of its own: the drawn category picture, swapped in the browser for up to three
// Google Places photos when it has them: `/api/places/photos/<slug>` on this site, which the
// Worker (`worker/index.ts`) passes through from the owner app (spec 056). Same-origin, so no
// blocker stops it. `v` changes when the answer's shape changes, so browsers drop a cached old answer.
const owner = ownerUrl(config, city);
const placesApi = owner && listing.images.length === 0 ? `/api/places/photos/${listing.slug}?v=3` : undefined;
const more = listing.images.length - shown.length;
// Without coordinates: a Google Maps search for the name and address (no pin to draw).
const mapsSearch = mapsSearchUrl([listing.name, listing.address, area?.name, city.name]);
// Without coordinates: Google's own embedded map for the same search shows the pin (no key needed).
const mapsEmbed = mapsEmbedUrl([listing.name, listing.address, area?.name, city.name]);
const appleMaps = appleMapsUrl(listing.geo, [listing.name, listing.address, area?.name, city.name]);
const trail: [string, string][] = [
    [config.company_name, '/'],
    [city.name, `/${city.id}`],
    ...(category ? ([[category.name, `/${city.id}/${category.id}`]] as [string, string][]) : []),
    [listing.name, listing.url],
];
---

<SoiGuruLayout
    title={`${listing.name}${listing.name_th ? ` · ${listing.name_th}` : ''}: ${category?.name ?? 'Place'} in ${area?.name ?? city.name}, ${city.name} · ${config.company_name}`}
    description={`${listing.description} ${listing.address ?? ''}`.trim()}
    config={config}
    path={listing.url}
    timeZone={city.timezone}
    city={city}
    jsonLd={[localBusinessJsonLd(listing, siteUrl), breadcrumbJsonLd(siteUrl, trail)]}
>
    <SiteHeader city={city} search />

    <main class="sg-wrap sg-lp-wrap">
        <nav class="sg-crumbs" aria-label="Breadcrumb">
            <a href={`/${city.id}`} data-th={city.name_th}>{city.name}</a>
            {
                area && (
                    <>
                        <span aria-hidden="true">/</span>
                        <a href={`/${city.id}/${area.id}`}>{area.name}</a>
                    </>
                )
            }
            {
                category && (
                    <>
                        <span aria-hidden="true">/</span>
                        <a href={`/${city.id}/${category.id}`} data-th={category.name_th}>{category.name}</a>
                    </>
                )
            }
            <span aria-hidden="true">/</span>
            <span aria-current="page">{listing.name}</span>
        </nav>

        <div class="sg-lp">
            <div class="sg-lp-photos">
            {
                shown.length === 0 && (
                    <div class="sg-pgrid sg-pgrid-art" data-count="1" data-places-photos={placesApi} data-places-name={listing.name}>
                        <CategoryArt category={category} size="lg" />
                    </div>
                )
            }
            {
                shown.length > 0 && (
                    <div class="sg-pgrid" data-count={shown.length}>
                        {shown.map((src, i) => (
                            <button type="button" class="sg-photo-btn" data-gallery-open={String(i)} aria-label={i === 0 ? 'Open photos' : `Open photo ${i + 1}`}>
                                <img src={src} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width={i === 0 ? 800 : 400} height={i === 0 ? 600 : 300} />
                            </button>
                        ))}
                        <span class="sg-pgrid-count">
                            <Icon name="camera" class="tkg-i-16" />
                            {listing.images.length} {listing.images.length === 1 ? 'photo' : 'photos'}
                            {more > 0 ? ` · +${more}` : ''}
                        </span>
                    </div>
                )
            }
            </div>

            <div class="sg-lp-head" data-listing={listing.slug} data-lat={listing.geo?.lat} data-lng={listing.geo?.lng} data-boat={area?.boat_only ? '1' : undefined}>
                <div class="sg-chips">
                    {
                        category && (
                            <a class="sg-chip sg-chip-sea" href={`/${city.id}/${category.id}`} data-th={category.name_th}>
                                {category.name}
                            </a>
                        )
                    }
                    {
                        listing.claimed && (
                            <span class="sg-chip sg-chip-ink">
                                <Icon name="check" class="tkg-i-16" />
                                <span data-th="เจ้าของยืนยันแล้ว">Verified owner</span>
                            </span>
                        )
                    }
                    {listing.sample && <span class="sg-chip" data-th="ตัวอย่าง">Sample listing</span>}
                </div>
                <h1 class="sg-lp-title">{listing.name}</h1>
                {listing.name_th && <p class="sg-lp-th" lang="th">{listing.name_th}</p>}
                <p class="sg-lp-meta">
                    <OpenStatus listing={listing} large />
                    {
                        listing.rating !== undefined && (
                            <span class="tkg-rating">
                                <Icon name="star" />
                                {listing.rating.toFixed(1)}
                                {listing.rating_count !== undefined && <span class="tkg-muted sg-regular">({listing.rating_count})</span>}
                            </span>
                        )
                    }
                    {price && <span>{price}</span>}
                    <span>
                        <Icon name="pin" class="tkg-i-16" /> <span data-th={area?.name_th}>{area?.name ?? city.name}</span><span data-distance data-walk></span>
                    </span>
                </p>
                <ContactBar listing={listing}>
                    <SaveButton slug={listing.slug} />
                    <button type="button" class="tkg-iconbtn sg-share" aria-label="Share" data-share={`${siteUrl}${listing.url}`} data-share-title={listing.name}>
                        <Icon name="share" />
                    </button>
                </ContactBar>
            </div>

            <aside class="sg-lp-side" aria-label="Location, opening hours and claim">
                {
                    (listing.geo || listing.address) && (
                        <section class="sg-card sg-where-sec" aria-label="Location">
                            {listing.geo ? (
                                <StaticMap point={listing.geo} height={240} width={480} />
                            ) : (
                                <iframe
                                    class="sg-where-embed"
                                    src={mapsEmbed}
                                    title={`Map: ${listing.name}`}
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    height="240"
                                ></iframe>
                            )}
                            {listing.address && (
                                <p class="sg-lp-address sg-addr-row">
                                    <span>{listing.address}</span>
                                    <button type="button" class="sg-copy-btn" data-copy={listing.address} aria-label="Copy address" title="Copy address" data-umami-event="copy-address">
                                        <Icon name="copy" class="tkg-i-16 sg-copy-i" />
                                        <Icon name="check" class="tkg-i-16 sg-copied-i" />
                                        <span class="sg-visually-hidden" data-copy-label>Copy address</span>
                                    </button>
                                </p>
                            )}
                            {listing.geo && (
                                <p class="sg-where-dist" data-lat={listing.geo.lat} data-lng={listing.geo.lng} data-boat={area?.boat_only ? '1' : undefined}>
                                    <span data-distance></span>
                                </p>
                            )}
                            <div class="sg-where-btns">
                                <a class="sg-btn sg-btn-sea" href={listing.geo ? directionsUrl(listing.geo) : mapsSearch} target="_blank" rel="noopener" data-umami-event="maps-google">
                                    <Icon name="navigation" class="tkg-i-16" />
                                    Google Maps
                                </a>
                                <a class="sg-btn sg-btn-secondary" href={appleMaps} target="_blank" rel="noopener" data-umami-event="maps-apple">
                                    <Icon name="map" class="tkg-i-16" />
                                    Apple Maps
                                </a>
                            </div>
                        </section>
                    )
                }
                <HoursTable listing={listing}>
                    {
                        listing.updated_at ? (
                            <p class="sg-card-foot" data-updated-at={listing.updated_at} data-updated-by={listing.updated_by}>
                                {provenance} on {formatDate(listing.updated_at)}
                            </p>
                        ) : (
                            <p class="sg-card-foot" data-th="ยังไม่ทราบวันที่อัปเดตล่าสุด">
                                Last update not known
                            </p>
                        )
                    }
                </HoursTable>
                <ClaimBox listing={listing} href={claimUrl(config, city, listing)} />
                <div class="sg-report">
                    {
                        report && (
                            <a href={report} data-th="แจ้งข้อมูลผิด">
                                Report wrong information
                            </a>
                        )
                    }
                    <small>Listing {listing.slug}</small>
                </div>
            </aside>

            <div class="sg-lp-body">
                <section class="sg-lp-sec" aria-labelledby="sg-about-h">
                    <h2 class="sg-h-md" id="sg-about-h" data-th="เกี่ยวกับ">About</h2>
                    <p class="sg-prose">{listing.description}</p>
                    {listing.description_th && <p class="sg-prose tkg-muted tkg-th" lang="th">{listing.description_th}</p>}
                </section>

                {
                    listing.amenities.length > 0 && (
                        <section class="sg-lp-sec" aria-labelledby="sg-good-h">
                            <h2 class="sg-h-md" id="sg-good-h" data-th="สิ่งที่ควรรู้">Good to know</h2>
                            <ul class="sg-pills">
                                {listing.amenities.map((a) =>
                                    a.available ? (
                                        <li>
                                            <Icon name="check" class="tkg-i-16" />
                                            <span data-th={a.name_th}>{a.name}</span>
                                        </li>
                                    ) : (
                                        <li class="sg-pill-no">
                                            <Icon name="close" class="tkg-i-16" />
                                            <span data-th={a.name_th ? `ไม่มี${a.name_th}` : undefined}>No {a.name.charAt(0).toLowerCase() + a.name.slice(1)}</span>
                                        </li>
                                    ),
                                )}
                            </ul>
                        </section>
                    )
                }

                {
                    nearby.length > 0 && (
                        <section class="sg-lp-sec sg-nearby-sec" data-open-now data-limit="3">
                            <div class="sg-sec-h">
                                <h2 class="sg-h-md" data-th="ใกล้เคียง · เปิดอยู่">Nearby · open now</h2>
                                {area && (
                                    <a class="sg-sec-link" href={`/${city.id}/${area.id}`} data-th="เพิ่มเติม">
                                        More in {area.name}
                                    </a>
                                )}
                            </div>
                            <div class="sg-tcards sg-tcards-sm">
                                {nearby.map(({ l, d }, i) => (
                                    <ListingCard listing={l} tile distance={d} hidden={i >= 3} />
                                ))}
                            </div>
                            <p class="sg-empty" data-open-empty hidden data-th="ตอนนี้ไม่มีที่ใกล้เคียงที่เปิดอยู่">
                                Nothing nearby is open right now.
                            </p>
                        </section>
                    )
                }
                {
                    similar.length > 0 && category && (
                        <section class="sg-lp-sec" aria-labelledby="sg-more-h">
                            <div class="sg-sec-h">
                                <h2 class="sg-h-md" id="sg-more-h" data-th={`${category.name_th ?? category.name}อื่นๆ ใน${similarInTh}`}>
                                    More {category.name.toLowerCase()} in {similarIn}
                                </h2>
                                <a class="sg-sec-link" href={`/${city.id}/${category.id}`} data-th="ดูทั้งหมด">
                                    See all
                                </a>
                            </div>
                            <div class="sg-tcards sg-tcards-sm">
                                {similar.map((l) => (
                                    <ListingCard listing={l} tile />
                                ))}
                            </div>
                        </section>
                    )
                }
            </div>
        </div>
    </main>

    {
        listing.geo && (
            <div class="tkg-bottombar" slot="nav" data-listing={listing.slug}>
                <div class="tkg-bb-info">
                    <OpenStatus listing={listing} />
                    <small data-lat={listing.geo.lat} data-lng={listing.geo.lng}>
                        <span data-distance>{area?.name ?? city.name}</span>
                    </small>
                </div>
                <a class="tkg-btn" href={directionsUrl(listing.geo)} target="_blank" rel="noopener">
                    <Icon name="navigation" />
                    <span data-th="เส้นทาง">Directions</span>
                </a>
            </div>
        )
    }

    {
        (listing.images.length > 0 || placesApi) && (
            <dialog class="sg-gallery" data-gallery aria-label={`Photos of ${listing.name}`}>
                <div class="sg-gallery-bar">
                    <span data-gallery-pos>1 / {listing.images.length}</span>
                    <button type="button" class="tkg-iconbtn" data-gallery-close aria-label="Close">
                        <Icon name="close" />
                    </button>
                </div>
                <div class="sg-gallery-track" data-gallery-track>
                    {listing.images.map((src, i) => (
                        <figure>
                            <img src={src} alt={`${listing.name}, photo ${i + 1}`} loading="lazy" decoding="async" />
                        </figure>
                    ))}
                </div>
                {(listing.images.length > 1 || placesApi) && (
                    <>
                        <button type="button" class="sg-gallery-step sg-gallery-prev" data-gallery-step="-1" aria-label="Previous photo">
                            <Icon name="chevron-left" />
                        </button>
                        <button type="button" class="sg-gallery-step sg-gallery-next" data-gallery-step="1" aria-label="Next photo">
                            <Icon name="chevron-right" />
                        </button>
                    </>
                )}
            </dialog>
        )
    }
</SoiGuruLayout>

<script>
    import '../../../scripts/soiguru/gallery';
    import '../../../scripts/soiguru/places';
    // Share sheet with the clean URL; falls back to copying it.
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
        btn.addEventListener('click', async () => {
            const url = btn.dataset['share'] ?? location.href;
            try {
                if (navigator.share) await navigator.share({ title: btn.dataset['shareTitle'], url });
                else await navigator.clipboard.writeText(url);
            } catch {
                // Cancelled by the visitor.
            }
        });
    }
</script>
