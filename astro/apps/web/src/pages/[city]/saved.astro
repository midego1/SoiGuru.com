---
/**
 * Saved (`/<city>/saved`): the places saved on this device with the heart on a listing
 * page. Every listing of the city is rendered hidden; `scripts/soiguru/saved.ts` shows
 * the saved ones, newest first. Kept out of the search index.
 */
import SoiGuruLayout from '../../layouts/SoiGuruLayout.astro';
import TopBar from '../../components/soiguru/TopBar.astro';
import ListingCard from '../../components/soiguru/ListingCard.astro';
import BottomNav from '../../components/soiguru/BottomNav.astro';
import { getSoiGuru, cityListings, ownerUrl, type City } from '../../lib/soiguru/data';

export async function getStaticPaths() {
    const { cities } = await getSoiGuru();
    return cities.map((city) => ({ params: { city: city.id }, props: { city } }));
}

interface Props {
    city: City;
}

const { city } = Astro.props;
const data = await getSoiGuru();
const { config } = data;
const owner = ownerUrl(config, city);
---

<SoiGuruLayout
    title={`Saved places in ${city.name} · ${config.company_name}`}
    description={`Places you saved in ${city.name}.`}
    config={config}
    path={`/${city.id}/saved`}
    timeZone={city.timezone}
    noindex
>
    <TopBar city={city} nav={{ city, active: 'saved', ownerHref: owner }} />
    <main>
        <section class="tkg-section" style="padding-top:20px">
            <div class="tkg-section-h">
                <h1 class="tkg-heading">
                    <span data-th="ที่บันทึกไว้">Saved places</span>
                    <small><span data-saved-count>0</span> · <span data-th="บันทึกไว้ในเครื่องนี้เท่านั้น">kept on this device only</span></small>
                </h1>
            </div>
            <div class="tkg-list sg-saved-list" data-saved-list>
                {cityListings(data, city).map((listing) => <ListingCard listing={listing} hidden />)}
            </div>
            <div class="sg-empty" data-saved-empty>
                <p style="margin:0 0 12px" data-th="แตะรูปหัวใจในหน้าร้านเพื่อบันทึกไว้ที่นี่">
                    Tap the heart on a place to keep it here.
                </p>
                <a class="tkg-btn tkg-btn-secondary" href={`/${city.id}`} data-th={`ดูร้านใน${city.name_th ?? city.name}`}>Browse {city.name}</a>
            </div>
        </section>
    </main>
    <BottomNav city={city} active="saved" ownerHref={owner} />
</SoiGuruLayout>
