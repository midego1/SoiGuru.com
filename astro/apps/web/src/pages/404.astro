---
/**
 * 404 Page — shown when a requested page is not found, in the SoiGuru design: the brand
 * top bar, a short EN/TH message and the cities to pick from, so visitors recover in one tap.
 * Kept out of the search index.
 */
import SoiGuruLayout from '../layouts/SoiGuruLayout.astro';
import TopBar from '../components/soiguru/TopBar.astro';
import Icon from '../components/soiguru/Icon.astro';
import { getSoiGuru, cityListings } from '../lib/soiguru/data';

const data = await getSoiGuru();
const { config, cities } = data;
---

<SoiGuruLayout title={`Page not found · ${config.company_name}`} description="This page does not exist or has moved." config={config} path="/404" noindex>
    <TopBar />
    <main>
        <div class="sg-header">
            <h1 class="tkg-display" data-th="ไม่พบหน้านี้">Page not found</h1>
            <p class="tkg-body tkg-muted" style="margin:0" data-th="หน้านี้ไม่มีอยู่หรือถูกย้ายแล้ว เลือกเมืองเพื่อค้นหาต่อ">
                This page doesn't exist or has moved. Pick a city to keep looking.
            </p>
        </div>

        <section class="tkg-section">
            <div class="tkg-section-h"><h2>Cities<small>เมือง</small></h2></div>
            <div class="tkg-rows sg-cities">
                {
                    cities.map((city) => {
                        const count = cityListings(data, city).length;
                        return (
                            <a class="tkg-row" href={`/${city.id}`}>
                                <div class="tkg-row-main">
                                    <span class="tkg-strong">{city.name}</span>
                                    <small>{[city.name_th, `${count} ${count === 1 ? 'place' : 'places'}`].filter(Boolean).join(' · ')}</small>
                                </div>
                                <Icon name="chevron-right" class="tkg-i-chev" />
                            </a>
                        );
                    })
                }
            </div>
        </section>

        <div class="tkg-section" style="padding-bottom:24px">
            <a class="tkg-btn tkg-btn-secondary" href="/" data-th="กลับหน้าแรก">Back to home</a>
        </div>
    </main>
</SoiGuruLayout>
