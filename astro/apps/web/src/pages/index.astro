---
/**
 * SoiGuru landing (`/`) — the cities, in the website mockup's layout: the hero, one card per
 * city (each opens that city's home), the owner block and the footer. One brand, many cities.
 * The template's generic item listing moved to `/directory` (redirected to `/`).
 */
import SoiGuruLayout from '../layouts/SoiGuruLayout.astro';
import TopBar from '../components/soiguru/TopBar.astro';
import Icon from '../components/soiguru/Icon.astro';
import OwnerBlock from '../components/soiguru/OwnerBlock.astro';
import ThailandMap from '../components/soiguru/ThailandMap.astro';
import { getSoiGuru, cityListings, claimUrl, ownerUrl } from '../lib/soiguru/data';

const data = await getSoiGuru();
const { config, cities } = data;
const first = cities[0];
const ownerHref = (first ? claimUrl(config, first) : undefined) ?? ownerUrl(config);
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const jsonLd = [
    { '@context': 'https://schema.org', '@type': 'WebSite', name: config.company_name, url: `${siteUrl}/` },
    {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: cities.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${siteUrl}/${c.id}` })),
    },
];
---

<SoiGuruLayout
    title={`${config.company_name}: local places in ${cities.map((c) => c.name).join(', ')}`}
    description={`Find what's open near you in ${cities.map((c) => c.name).join(', ')}: restaurants, massage, nail salons, scooters, tours and more, in English and Thai.`}
    config={config}
    path="/"
    jsonLd={jsonLd}
>
    <TopBar />
    <main class="sg-main-full">
        <section class="sg-hero">
            <div class="sg-wrap sg-hero-grid">
                <div class="sg-hero-copy">
                    <p class="sg-hero-eyebrow">{cities.map((c) => c.name).join(' · ')}</p>
                    <h1 class="sg-hero-h"><span data-th="ค้นหาทุกอย่างใกล้คุณ">Find anything near you</span> <span data-th="ในประเทศไทย">in Thailand.</span></h1>
                    <p class="sg-hero-lead" data-th="เลือกเมือง สถานที่ เวลาเปิด-ปิด และช่องทางติดต่อ ทั้งภาษาอังกฤษและไทย">
                        Pick a city. Places, opening hours and contacts in English and Thai.
                    </p>
                    <div class="sg-hero-cities">
                        {
                            cities.map((city) => (
                                <a class="sg-btn sg-btn-onhero" href={`/${city.id}`} data-city-hover={city.id}>
                                    <Icon name="pin" class="tkg-i-16" />
                                    <span data-th={city.name_th}>{city.name}</span>
                                </a>
                            ))
                        }
                    </div>
                </div>
                <div class="sg-hero-art sg-hero-map">
                    <ThailandMap cities={cities} uid="hero" />
                </div>
            </div>
        </section>

        <section class="sg-wrap sg-sec sg-sec-first" aria-labelledby="sg-cities-h">
            <div class="sg-sec-h">
                <h2 class="sg-h-lg" id="sg-cities-h" data-th="เมือง">Cities</h2>
            </div>
            <div class="sg-areas">
                {
                    cities.map((city, i) => {
                        const count = cityListings(data, city).length;
                        return (
                            <a class="sg-area" href={`/${city.id}`} style={`--area-bg: var(--area-${(i % 5) + 1})`} data-city-hover={city.id}>
                                <span class="sg-area-art" aria-hidden="true">
                                    <svg viewBox="0 0 200 80" preserveAspectRatio="none" focusable="false">
                                        <path d={i % 2 ? 'M0 80 C30 40 46 22 62 44 C74 20 96 8 110 40 C122 64 140 56 156 66 C170 40 186 46 200 60 V80 Z' : 'M0 80 C18 54 30 30 48 50 C64 18 84 14 98 46 C112 30 130 34 140 56 C156 36 178 28 200 52 V80 Z'} fill="currentColor" />
                                    </svg>
                                </span>
                                <span class="sg-area-body">
                                    <span class="sg-area-name">{city.name}</span>
                                    <span class="sg-area-count">
                                        {[city.name_th, city.province && city.province !== city.name ? city.province : null, `${count} ${count === 1 ? 'place' : 'places'}`]
                                            .filter(Boolean)
                                            .join(' · ')}
                                    </span>
                                </span>
                            </a>
                        );
                    })
                }
            </div>
        </section>

        <OwnerBlock href={ownerHref} cityName={cities.length === 1 ? first?.name : undefined} cityId={cities.length === 1 ? first?.id : undefined} count={first && cities.length === 1 ? cityListings(data, first).length : undefined} />
    </main>
</SoiGuruLayout>
